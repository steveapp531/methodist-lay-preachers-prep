# ─────────────────────────────────────────────────────────────────────────────
# Methodist Lay Preachers' Examination Preparation Platform
#
# Copy this file to `.env` in the repository root and fill it in.
#   cp .env.example .env
#
# The defaults are enough to run the whole application locally with no
# additional setup. Nothing here is a real secret; generate your own before
# deploying anywhere.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Backend ──────────────────────────────────────────────────────────────────
PORT=5000

# Database.
#
# Leave MONGODB_URI empty and the server starts an embedded MongoDB on first
# run, storing its data in `.data/mongodb` so your progress survives restarts.
# That is the zero-configuration path and needs no MongoDB installation.
#
# For a local MongoDB:   mongodb://127.0.0.1:27017/mlpp
# For MongoDB Atlas:     mongodb+srv://USER:PASSWORD@cluster.mongodb.net/mlpp?retryWrites=true&w=majority
#
# MONGODB_URI is REQUIRED in production; the embedded database is refused there.
MONGODB_URI=

# Force the embedded database even when MONGODB_URI is set (development only).
USE_MEMORY_DB=
MEMORY_DB_PATH=

# Authentication secrets.
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Both must be at least 16 characters. The server refuses to start in
# production without them.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=30d
REFRESH_COOKIE_NAME=mlpp_refresh

# Which origins the API accepts browser requests from, comma separated.
# In production this must list your deployed web address exactly.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:4173

# Set to true when the API runs behind a proxy or load balancer (Render, Fly,
# Heroku) so rate limiting sees the real client address.
TRUST_PROXY=

# ── Optional AI marking of theory answers ────────────────────────────────────
#
# Leave AI_PROVIDER as `none` and theory answers are still marked, by the
# deterministic rubric engine. No key, no network, no cost.
#
# Set it to `anthropic` with a key and the marker additionally asks a model to
# judge coverage of each rubric criterion. The model is given only the question,
# the ideal answer, the rubric and the syllabus excerpt, and is forbidden from
# introducing doctrine of its own; anything it cannot evidence from the
# candidate's own words falls back to the rubric engine.
#
# NEVER put this key anywhere the browser can reach it.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AI_TIMEOUT_MS=30000

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=25

# ── Seeding ──────────────────────────────────────────────────────────────────
#
# If SEED_ADMIN_PASSWORD is set, `npm run seed` creates this administrator.
# Leaving it empty is safer: create one interactively with `npm run create:admin`
# so the password never lands in a file.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# ── Frontend ─────────────────────────────────────────────────────────────────
#
# In development the Vite dev server proxies /api to the backend, so leave
# VITE_API_URL empty. Set it in production to your deployed API, including /api.
#   VITE_API_URL=https://your-api.onrender.com/api
VITE_API_URL=
VITE_PORT=5173
VITE_DEV_API_PROXY=http://localhost:5000
