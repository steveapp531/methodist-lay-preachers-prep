{
  "name": "methodist-lay-preachers-prep",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Examination preparation platform for the Methodist Church Ghana Connexional Lay Preachers' Examination",
  "engines": {
    "node": ">=18.17"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "seed": "npm run seed --workspace backend",
    "seed:reset": "npm run seed:reset --workspace backend",
    "create:admin": "npm run create:admin --workspace backend",
    "test": "npm run test --workspace backend",
    "lint": "npm run lint --workspaces --if-present",
    "verify:content": "node scripts/verify-content.mjs",
    "merge:content": "node scripts/merge-content.mjs",
    "shuffle:options": "node scripts/shuffle-options.mjs",
    "repair:excerpts": "node scripts/repair-excerpts.mjs",
    "build:scripture": "node scripts/build-scripture-texts.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "kjv": "^1.0.0"
  }
}
